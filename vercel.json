{
  "version": 2,
  "rewrites": [
    {
      "source": "/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/scrape",
      "destination": "/api/scrape"
    },
    {
      "source": "/zoho",
      "destination": "/api/zoho"
    },
    {
      "source": "/sheets",
      "destination": "/api/sheets"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}